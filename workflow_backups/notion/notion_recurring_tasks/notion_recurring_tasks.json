    {
      "parameters": {
        "jsCode": "function getNextDaySkipWeekend(dateString) {\n  try {\n    const date = new Date(dateString);\n    \n    if (isNaN(date.getTime())) {\n      throw new Error('Invalid date format provided.');\n    }\n\n    // 1. Always start by adding 1 day (tomorrow)\n    date.setDate(date.getDate() + 1);\n\n    // 2. Check which day of the week it is\n    // JavaScript counts: 0=Sunday, ... 5=Friday, 6=Saturday\n    const dayOfWeek = date.getDay();\n\n    // 3. If it lands on a weekend, push it to Sunday\n    if (dayOfWeek === 5) { \n      // It is Friday -> Add 2 days to get to Sunday\n      date.setDate(date.getDate() + 2);\n    } else if (dayOfWeek === 6) { \n      // It is Saturday -> Add 1 day to get to Sunday\n      date.setDate(date.getDate() + 1);\n    }\n    \n    // If it's Sunday through Thursday, we leave it alone.\n\n    return date.toISOString();\n  } catch (error) {\n    console.error(\"Error calculating next day:\", error.message);\n    return null;\n  }\n}\n\nfor (const item of items) {\n  const myDate = item.json.property_last_edited_time;\n  \n  // Calculate the next day, skipping weekends\n  const nextDay = getNextDaySkipWeekend(myDate);\n\n  item.json.nextDay = nextDay;\n}\n\nreturn items;"
      },
