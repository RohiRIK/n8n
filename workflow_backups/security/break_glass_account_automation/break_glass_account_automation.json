    },
    {
      "parameters": {
        "jsCode": "// Get current policy and emergency account\nconst policy = $input.item(0).json;\nconst emergencyAccount = $('Initialize_emergency_Accounts').item(0).json.emergencyAccount1;\n\n// Create a deep copy of the policy to modify\nconst updatedPolicy = JSON.parse(JSON.stringify(policy));\n\n// Make sure excludeUsers exists\nif (!updatedPolicy.conditions.users.excludeUsers) {\n  updatedPolicy.conditions.users.excludeUsers = [];\n}\n\n// Add emergency account to excluded users if not already present\nif (!updatedPolicy.conditions.users.excludeUsers.includes(emergencyAccount)) {\n  updatedPolicy.conditions.users.excludeUsers.push(emergencyAccount);\n}\n\n// Return the updated policy and original policy id\nreturn [\n  {\n    json: {\n      policyId: policy.id,\n      updatedPolicy: {\n        conditions: {\n          users: {\n            excludeUsers: updatedPolicy.conditions.users.excludeUsers\n          }\n        }\n      }\n    }\n  }\n];"
      },
