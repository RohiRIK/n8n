    },
    {
      "parameters": {
        "jsCode": "// Return notification status\nconst slackResponse = $input.item(0)?.json || {};\nconst teamsResponse = $input.item(1)?.json || {};\n\nreturn [{\n  json: {\n    status: 'sent',\n    slack: {\n      sent: slackResponse.ok !== false,\n      response: slackResponse\n    },\n    teams: {\n      sent: teamsResponse.error === undefined,\n      response: teamsResponse\n    },\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
