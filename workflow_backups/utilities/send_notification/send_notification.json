      "parameters": {
        "jsCode": "// Validate and extract notification data\nconst input = $input.first().json;\n\nreturn [{\n  json: {\n    channel: input.channel || '#security-alerts',\n    title: input.title || 'Security Alert',\n    severity: input.severity || 'medium',\n    message: input.message || '',\n    data: input.data || {},\n    notificationType: input.notificationType || 'slack'\n  }\n}];"
      },
