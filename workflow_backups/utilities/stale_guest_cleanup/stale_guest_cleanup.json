              "neverError": true
            }
          }
        }
      },
      "name": "Delete User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1650,
        200
      ],
      "id": "a051562f-0705-4593-a437-7080d7ec347f"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Prepare notification data\nconst data = $node['Identify Stale'].json;\nconst staleGuests = data.staleGuests || [];\nconst autoDeleteEnabled = data.autoDeleteEnabled;\n\nlet message = `\ud83d\udcca *Weekly Stale Guest Cleanup Report*\\n\\n`;\nmessage += `Total Guests Checked: ${data.totalGuestsChecked}\\n`;\nmessage += `Stale Guests Found: ${data.totalStaleGuests}\\n`;\nmessage += `Threshold: ${data.thresholdDays} days\\n`;\nmessage += `Auto-Delete: ${autoDeleteEnabled ? '\u2705 ENABLED' : '\u274c DISABLED'}\\n\\n`;\n\nif (data.totalStaleGuests === 0) {\n  message += `\u2705 No stale guest accounts found`;\n} else {\n  if (autoDeleteEnabled) {\n    message += `\u26a0\ufe0f *Deleted Accounts (${staleGuests.length})*\\n`;\n  } else {\n    message += `\ud83d\udccb *Stale Accounts Identified (Manual Review Required)*\\n`;\n  }\n  \n  staleGuests.slice(0, 10).forEach(guest => {\n    message += `\u2022 ${guest.displayName} (${guest.userPrincipalName})\\n`;\n    message += `  Last Sign-In: ${guest.daysSinceSignIn} days ago\\n`;\n  });\n  \n  if (staleGuests.length > 10) {\n    message += `... and ${staleGuests.length - 10} more\\n`;\n  }\n  \n  if (!autoDeleteEnabled) {\n    message += `\\n\u26a0\ufe0f To enable automatic deletion, set environment variable:\\n`;\n    message += `AUTO_DELETE_ENABLED=true\\n`;\n  }\n}\n\nmessage += `\\nTimestamp: ${new Date().toISOString()}`;\n\nreturn [{\n  json: {\n    channel: '#security-alerts',\n    title: '\ud83d\udcca Stale Guest Report',\n    severity: autoDeleteEnabled && data.totalStaleGuests > 0 ? 'high' : 'medium',\n    message: message,\n    data: data\n  }\n}];"
      },
