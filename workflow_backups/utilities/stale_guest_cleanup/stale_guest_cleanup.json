        "jsCode": "// Configure stale guest cleanup\nreturn [{\n  json: {\n    tenantId: $env.MS_TENANT_ID,\n    clientId: $env.MS_CLIENT_ID,\n    inactiveDaysThreshold: 90,\n    autoDeleteEnabled: $env.AUTO_DELETE_ENABLED === 'true'\n  }\n}];"
      },
      "name": "Set Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "id": "599e7970-f059-4439-bc7b-d39bfa2266d0"
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "MS Graph - Get Token",
          "mode": "name"
        },
        "options": {
          "inputData": {
            "mode": "json",
            "jsonData": "={\"tenantId\": \"{{$json.tenantId}}\", \"clientId\": \"{{$json.clientId}}\"}"
          }
        }
      },
      "name": "Get Token",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        650,
