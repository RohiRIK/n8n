      ],
      "id": "846414c6-e33c-4477-a390-4edb882f95a6"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.microsoft.com/v1.0/users?$filter=userType eq 'Guest'&$select=id,displayName,userPrincipalName,signInActivity,createdDateTime&$count=true",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$node['Get Token'].json.accessToken}}"
            },
            {
              "name": "ConsistencyLevel",
              "value": "eventual"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Get Guest Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        300
      ],
      "id": "b7184979-bc8f-442b-a4fd-885a25860a76"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Identify stale guest users\nconst users = $input.first().json.value || [];\nconst threshold = $node['Set Config'].json.inactiveDaysThreshold;\nconst staleGuests = [];\n\n// Calculate threshold date\nconst thresholdDate = new Date();\nthresholdDate.setDate(thresholdDate.getDate() - threshold);\n\nfor (const user of users) {\n  // Get last sign-in date (use createdDateTime if never signed in)\n  const lastSignIn = user.signInActivity?.lastSignInDateTime \n    ? new Date(user.signInActivity.lastSignInDateTime)\n    : new Date(user.createdDateTime);\n  \n  // Check if user is stale\n  if (lastSignIn < thresholdDate) {\n    const daysSinceSignIn = Math.floor((Date.now() - lastSignIn.getTime()) / (1000 * 60 * 60 * 24));\n    \n    staleGuests.push({\n      userId: user.id,\n      displayName: user.displayName,\n      userPrincipalName: user.userPrincipalName,\n      lastSignInDate: lastSignIn.toISOString(),\n      daysSinceSignIn: daysSinceSignIn,\n      createdDate: user.createdDateTime,\n      timestamp: new Date().toISOString()\n    });\n  }\n}\n\nreturn [{\n  json: {\n    staleGuests: staleGuests,\n    totalStaleGuests: staleGuests.length,\n    totalGuestsChecked: users.length,\n    thresholdDays: threshold,\n    autoDeleteEnabled: $node['Set Config'].json.autoDeleteEnabled\n  }\n}];"
      },
      "name": "Identify Stale",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "id": "0d08dd38-7cc2-46f4-9833-775ca588e527"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition1",
              "leftValue": "={{$json.autoDeleteEnabled}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "condition2",
              "leftValue": "={{$json.totalStaleGuests}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "IF Auto-Delete Enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1250,
